# ---------------------------------------------------------------------------
# Flight Hunter configuration
#
# Every value here is OPTIONAL. With no .env at all the app runs on realistic
# offline sample data, so you can try everything before signing up anywhere.
# Copy this file to .env and fill in what you need.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated allowed browser origins, or * to allow any.
CORS_ORIGINS=http://localhost:5173

# --- Amadeus (live fares) -------------------------------------------------
# Free self-service key: https://developers.amadeus.com  (~3 minutes)
# BOTH values are required; setting only one is treated as unconfigured.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# test = sandbox prices (free, generous quota) | prod = real bookable fares
# https://test.api.amadeus.com  or  https://api.amadeus.com
AMADEUS_BASE_URL=https://test.api.amadeus.com

# --- Travelpayouts (cached fares + booking links) -------------------------
# https://travelpayouts.com -> Profile -> API token
TRAVELPAYOUTS_TOKEN=
# Optional affiliate marker appended to booking links.
TRAVELPAYOUTS_MARKER=

# --- Storage --------------------------------------------------------------
# Relative paths resolve against packages/server, so the file stays in one
# place no matter which directory you launch from.
DATABASE_PATH=./data/flighthunter.db

# --- Performance ----------------------------------------------------------
# How long a provider result stays reusable.
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=500

# Parallel upstream calls. The Amadeus test tier allows about 10 req/s.
PROVIDER_CONCURRENCY=4
PROVIDER_TIMEOUT_MS=20000

# Per-IP budget for the search endpoint.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30

# --- Background price alerts ----------------------------------------------
# Minutes between automatic alert checks. 0 disables the scheduler entirely
# (you can still press "Check now" in the Alerts panel).
ALERT_POLL_MINUTES=0
